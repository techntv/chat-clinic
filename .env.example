# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
# Your domain (keep localhost for the container health check).
DJANGO_ALLOWED_HOSTS=bot.example.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://bot.example.com
LOG_LEVEL=INFO

# --- Caddy (HTTPS) ---
# Public domain pointing at the VPS. Use "localhost" for local runs.
DOMAIN=bot.example.com

# --- Postgres (used by the db service and to build DATABASE_URL for web) ---
POSTGRES_DB=clinic
POSTGRES_USER=clinic
POSTGRES_PASSWORD=change-me
# Only needed when running Django outside Docker:
# DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic

# --- Meta / Messenger ---
# Any random string; you type the same value in the Meta webhook settings.
FB_VERIFY_TOKEN=change-me
# Meta app > App settings > Basic > App secret. Used to check X-Hub-Signature-256.
FB_APP_SECRET=change-me
# Check the current version at https://developers.facebook.com/docs/graph-api/changelog
GRAPH_API_VERSION=v24.0

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# Current Haiku model: https://platform.claude.com/docs/en/about-claude/models/overview
CLAUDE_MODEL=claude-haiku-5-5
# low | medium | high. "low" keeps chat replies fast and cheap.
CLAUDE_EFFORT=low
CLAUDE_MAX_TOKENS=2048
CLAUDE_MAX_TOOL_ROUNDS=4
CLAUDE_HISTORY_MESSAGES=12
# Prices in USD per million tokens, for cost logging and the eval script.
CLAUDE_INPUT_USD_PER_MTOK=0.10
CLAUDE_OUTPUT_USD_PER_MTOK=0.50

# --- Google Sheets ---
# In Docker: put the key at ./secrets/google-service-account.json (compose mounts it).
# Outside Docker: set the path here.
# GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json
SHEET_CACHE_MINUTES=15

# --- Background processing ---
BACKGROUND_WORKERS=4
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
